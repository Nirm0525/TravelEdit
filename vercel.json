{
  "framework": "angular",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/TravelEdit/browser",
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/:path*", "destination": "/admin/index.html" },
    { "source": "/disenar-tu-viaje", "destination": "/index.html" },
    { "source": "/the-edit/:slug", "destination": "/index.html" }
  ]
}
